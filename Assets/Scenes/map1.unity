        MASTER ","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[],"EditorInfo":{"isRoot":false,"xPos":-183.333649,"yPos":400.6673},"ID":6,"ParamActions":[],"TMPFontGUID":null,"Text":"Go.
